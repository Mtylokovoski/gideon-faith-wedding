# ─────────────────────────────────────────────────────────────
# Gideon & Faith — Wedding Photo Booth
# Copy this file to `.env.local` for local work, and add the same
# names/values in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── BROWSER values (VITE_ prefix = shipped to the browser; must be non-secret) ──

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API → "anon" (legacy) or "publishable" key.
# This key is designed to be public. NEVER put the service-role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Your live website address. The QR code generator uses this and refuses
# to build a code for localhost. Example: https://gideon-and-faith.vercel.app
VITE_SITE_URL=https://YOUR-DOMAIN.com

# Slug of the wedding row in the database (the "/" page redirects here)
VITE_DEFAULT_WEDDING_SLUG=gideon-faith

# OPTIONAL: Cloudflare Turnstile site key (CAPTCHA). Leave blank to disable.
VITE_TURNSTILE_SITE_KEY=


# ── SERVER-ONLY values (used by /api functions on Vercel; NEVER prefix with VITE_) ──

# Same as VITE_SUPABASE_URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API → "service_role" (legacy) or "secret" key.
# Gives full database access. Keep it ONLY in Vercel's server environment.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (e.g. `openssl rand -hex 32`). Used to hash visitor IPs
# for upload rate limiting, so raw IP addresses are never stored.
RATE_LIMIT_SALT=

# OPTIONAL tuning. Defaults shown. Wedding venues often share ONE Wi-Fi/IP,
# so the per-IP limit is deliberately generous.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_GLOBAL_MAX=3000

# OPTIONAL: Cloudflare Turnstile secret key. If set, uploads require a passed check.
TURNSTILE_SECRET_KEY=

# Any long random string. Vercel sends it to the daily cleanup job automatically.
CRON_SECRET=
